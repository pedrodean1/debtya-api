    "axios": "^1.15.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "plaid": "^41.4.0",
    "resend": "^6.12.3",
    "stripe": "^22.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
