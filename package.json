    "smoke:local:intents": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-test.ps1 -ApiBaseUrl http://localhost:3000 -IncludePaymentIntents",
    "smoke:local:full": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-test.ps1 -ApiBaseUrl http://localhost:3000 -IncludePaymentIntents -IncludeAccountsDebtsRules",
    "validate:env": "node scripts/validate-env.js",
    "sql:apply:spinwheel-debts": "node scripts/apply-sql-file.mjs sql/add_debts_spinwheel_columns_if_missing.sql",
    "sql:apply:payment-intents-status": "node scripts/apply-sql-file.mjs sql/normalize_payment_intents_status_v125.sql",
    "test": "node --test ./test/lib/validation.test.js ./test/lib/manual-plan-next-payment.test.js ./test/lib/manual-plan-rebuild.test.js ./test/lib/manual-extra-payment.test.js ./test/lib/debt-paid-helpers.test.js ./test/lib/payment-intent-stale-guard.test.js ./test/lib/notifications-transactional-email.test.js ./test/lib/strategy-compare-sim.test.js ./test/lib/method-env.test.js ./test/lib/method-client.test.js ./test/lib/notifications.test.js ./test/lib/minimum-payment-tracking.test.js ./test/lib/spinwheel-env.test.js ./test/lib/spinwheel-client.test.js ./test/lib/spinwheel-users.test.js ./test/lib/spinwheel-debt-import.test.js ./test/lib/spinwheel-payable-summary.test.js ./test/lib/spinwheel-payment-intents.test.js ./test/lib/spinwheel-payments-validate.test.js ./test/lib/debtya-beta-flags.test.js ./test/lib/confirm-manual-intent.test.js ./test/scripts/validate-env.test.js ./test/public-index-plaid-policy.test.js ./test/routes/payment-intents-routes.test.js ./test/routes/debts-extra-payment-routes.test.js ./test/routes/ai-coach-routes.test.js ./test/routes/notifications-routes.test.js ./test/routes/cron-routes.test.js ./test/routes/stripe-webhook-routes.test.js ./test/routes/spinwheel-routes.test.js ./test/routes/billing-checkout-beta.test.js ./test/routes/core-health.test.js ./test/routes/guide-routes.test.js ./test/routes/legacy-status-routes.test.js",
    "security:preflight": "powershell -ExecutionPolicy Bypass -File ./scripts/security-preflight.ps1",
    "gen:brand": "node scripts/gen-debtya-brand-pngs.cjs",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "keywords": [],
